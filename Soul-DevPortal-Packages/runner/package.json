{
  "name": "@workspace/runner",
  "version": "2.0.0",
  "description": "Universal Process Supervision, Port Conflict Resolution and Fullstack Dev Runners for Workspace",
  "main": "./external/run_dev.py",
  "bin": {
    "soul-dev": "./bin/soul-dev.js",
    "soul-runner": "./bin/soul-runner.js"
  },
  "type": "module",
  "scripts": {
    "dev": "python external/run_dev.py --kill-port",
    "dev:all": "python external/run_all.py --kill-port",
    "dev:client": "python external/run_client.py --kill-port",
    "dev:server": "python external/run_server.py --kill-port",
    "install:deps": "python external/run_install.py",
    "typecheck": "python external/run_typecheck.py",
    "lint": "python external/run_lint.py",
    "build": "python external/run_build.py",
    "test": "python tests/test_registry.py && python tests/test_visual_len.py && python tests/test_supervisor.py"
  },
  "files": [
    "internal",
    "external",
    "README.md"
  ],
  "keywords": [
    "workspace",
    "runner",
    "supervisor",
    "dev-server",
    "orchestrator"
  ],
  "license": "MIT"
}
