{
  "name": "@workspace/config",
  "version": "2.0.0",
  "description": "Centralized, enterprise configuration presets for TypeScript, Tailwind CSS, Prettier, ESLint, and Python",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "bin": {
    "soul-ports": "./bin/soul-ports.js"
  },
  "scripts": {
    "ports": "python external/run_ports.py",
    "ports:kill": "python external/run_ports.py --kill-conflicts",
    "ports:json": "python external/run_ports.py --json",
    "test": "python tests/test_ports_integrity.py && python tests/test_internal.py && python tests/test_external.py"
  },
  "exports": {
    ".": "./index.js",
    "./tsconfig/base.json": "./external/presets/tsconfig/base.json",
    "./tsconfig/react.json": "./external/presets/tsconfig/react.json",
    "./tsconfig/next.json": "./external/presets/tsconfig/next.json",
    "./tsconfig/node.json": "./external/presets/tsconfig/node.json",
    "./tsconfig/library.json": "./external/presets/tsconfig/library.json",
    "./tsconfig/test.json": "./external/presets/tsconfig/test.json",
    "./tailwind/preset": "./external/presets/tailwind/preset.js",
    "./tailwind/tokens": "./external/presets/tailwind/tokens.js",
    "./prettier": "./external/presets/prettier/index.json",
    "./eslint/base": "./external/presets/eslint/base.js",
    "./eslint/react": "./external/presets/eslint/react.js",
    "./eslint/next": "./external/presets/eslint/next.js"
  },
  "files": [
    "index.js",
    "internal",
    "external",
    "README.md"
  ],
  "keywords": [
    "workspace",
    "config",
    "tsconfig",
    "tailwind",
    "prettier",
    "eslint"
  ]
}
