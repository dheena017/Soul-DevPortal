{
  "name": "@workspace/logger",
  "version": "1.0.0",
  "description": "Universal 5-column logging, DevTools HMR bridge, and terminal presentation package for Workspace",
  "main": "./client/index.ts",
  "types": "./client/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./client/index.ts",
      "import": "./client/index.ts",
      "default": "./client/index.ts"
    },
    "./client": {
      "types": "./client/client.ts",
      "import": "./client/client.ts",
      "default": "./client/client.ts"
    },
    "./vite": {
      "types": "./client/vite-plugin.ts",
      "import": "./client/vite-plugin.ts",
      "default": "./client/vite-plugin.ts"
    },
    "./server": {
      "types": "./client/server.ts",
      "import": "./client/server.ts",
      "default": "./client/server.ts"
    }
  },
  "files": [
    "client",
    "internal",
    "external",
    "README.md"
  ],
  "scripts": {
    "test": "python tests/test_internal.py && python tests/test_external.py && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "workspace",
    "logger",
    "telemetry",
    "vite-hmr",
    "dev-tools",
    "supervisor"
  ],
  "license": "MIT"
}
