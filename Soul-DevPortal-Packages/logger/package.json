{
  "name": "@workspace/logger",
  "version": "1.0.0",
  "description": "Universal 5-column logging, DevTools HMR bridge, and terminal presentation package for Workspace",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./vite": {
      "types": "./src/vite-plugin.ts",
      "import": "./src/vite-plugin.ts",
      "default": "./src/vite-plugin.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "files": [
    "src",
    "workspace_logger",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "workspace",
    "logger",
    "telemetry",
    "vite-hmr",
    "dev-tools",
    "supervisor"
  ],
  "license": "MIT"
}
