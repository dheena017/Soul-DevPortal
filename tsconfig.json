{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/logger": ["Soul-DevPortal-Packages/logger/external/client/index.ts"],
      "@workspace/logger/*": ["Soul-DevPortal-Packages/logger/external/client/*"],
      "@workspace/config/tailwind/tokens": ["Soul-DevPortal-Packages/config/external/presets/tailwind/tokens.js"],
      "@workspace/config/tailwind/preset": ["Soul-DevPortal-Packages/config/external/presets/tailwind/preset.js"],
      "@workspace/config/*": ["Soul-DevPortal-Packages/config/external/presets/*"],
      "@workspace/config": ["Soul-DevPortal-Packages/config/external/presets/tailwind/tokens.js"],
      "@workspace/runner/*": ["Soul-DevPortal-Packages/runner/*"],
      "@workspace/*": ["Soul-DevPortal-Packages/*/external/client/index.ts"]
    }
  },
  "include": ["src", "vite.config.js"]
}
