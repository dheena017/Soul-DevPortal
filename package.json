{
  "name": "@soul-dev/portal",
  "private": true,
  "version": "2.0.0",
  "description": "Interactive developer portal, architecture specs, and live package explorer for the Soul Workspace monorepo.",
  "main": "electron/main.cjs",
  "type": "module",
  "workspaces": [
    "Soul-DevPortal-Packages/*"
  ],
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --port 5181",
    "desktop": "npm run build && node electron/launch.cjs",
    "desktop:dev": "node electron/launch.cjs --dev",
    "desktop:shortcut": "python -c \"import sys; sys.path.insert(0, 'server'); from features.soul_dev_portal.service import SoulDevPortalService; print(SoulDevPortalService.create_desktop_shortcut())\"",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:build": "npm run build && electron-builder --win",
    "clean": "node -e \"['dist'].forEach(p => fs.rmSync(p, {recursive: true, force: true}))\"",
    "dev": "soul-dev --kill-port",
    "dev:client": "soul-runner client --kill-port",
    "dev:server": "soul-runner server --kill-port",
    "dev:portal:server": "python server/main.py --port 8008 --reload",
    "extract": "python server/main.py --extract-only",
    "dev:all": "soul-runner all --kill-port",
    "dev:all:client": "soul-runner all --client-only --kill-port",
    "dev:all:server": "soul-runner all --server-only --kill-port",
    "dev:project": "soul-dev --kill-port",
    "dev:apexmind": "soul-runner all --project apexmind-ai --kill-port",
    "dev:apexmind:client": "soul-runner all --project apexmind-ai --client-only --kill-port",
    "dev:apexmind:server": "soul-runner all --project apexmind-ai --server-only --kill-port",
    "dev:sonikoma": "soul-runner all --project sonikoma --kill-port",
    "dev:sonikoma:client": "soul-runner all --project sonikoma --client-only --kill-port",
    "dev:sonikoma:server": "soul-runner all --project sonikoma --server-only --kill-port",
    "dev:outpass": "soul-runner all --project outpass-system --kill-port",
    "dev:outpass:client": "soul-runner all --project outpass-system --client-only --kill-port",
    "dev:outpass:server": "soul-runner all --project outpass-system --server-only --kill-port",
    "dev:free-api": "soul-runner all --project free-api-hub --kill-port",
    "dev:free-api:client": "soul-runner all --project free-api-hub --client-only --kill-port",
    "dev:free-api:server": "soul-runner all --project free-api-hub --server-only --kill-port",
    "dev:spatial": "soul-runner all --project spatial-dimensions --kill-port",
    "dev:spatial:client": "soul-runner all --project spatial-dimensions --client-only --kill-port",
    "dev:spatial:server": "soul-runner all --project spatial-dimensions --server-only --kill-port",
    "dev:college": "soul-runner all --project college-management-system --kill-port",
    "dev:college:client": "soul-runner all --project college-management-system --client-only --kill-port",
    "dev:college:server": "soul-runner all --project college-management-system --server-only --kill-port",
    "dev:globalpulse": "soul-runner all --project globalpulse-ai --kill-port",
    "dev:globalpulse:client": "soul-runner all --project globalpulse-ai --client-only --kill-port",
    "dev:globalpulse:server": "soul-runner all --project globalpulse-ai --server-only --kill-port",
    "dev:postcraft": "soul-runner all --project postcraft-ai --kill-port",
    "dev:postcraft:client": "soul-runner all --project postcraft-ai --client-only --kill-port",
    "dev:postcraft:server": "soul-runner all --project postcraft-ai --server-only --kill-port",
    "dev:home": "soul-runner all --project home-management --kill-port",
    "dev:home:client": "soul-runner all --project home-management --client-only --kill-port",
    "dev:home:server": "soul-runner all --project home-management --server-only --kill-port",
    "dev:home-management": "soul-runner all --project home-management --kill-port",
    "dev:home-management:client": "soul-runner all --project home-management --client-only --kill-port",
    "dev:home-management:server": "soul-runner all --project home-management --server-only --kill-port",
    "build:all": "soul-runner build --all --clean",
    "lint": "soul-runner lint",
    "lint:all": "soul-runner lint --all",
    "typecheck": "soul-runner typecheck",
    "typecheck:all": "soul-runner typecheck --all",
    "deps:audit": "soul-runner install --check-only",
    "deps:install": "soul-runner install --all",
    "ports:status": "soul-ports",
    "ports:kill": "soul-ports --kill-conflicts",
    "ports:json": "soul-ports --json",
    "health": "soul-ports",
    "cli": "python scripts/cli.py",
    "pkg:test": "python Soul-DevPortal-Packages/config/tests/test_ports_integrity.py && python Soul-DevPortal-Packages/logger/tests/test_internal.py && python Soul-DevPortal-Packages/runner/tests/test_supervisor.py",
    "pkg:scaffold": "python scripts/scaffold_packages.py",
    "pkg:test:all": "python scripts/test_all_packages.py",
    "pkg:publish": "python Soul-DevPortal-scripts/publish_github_packages.py",
    "pkg:publish:dry": "python Soul-DevPortal-scripts/publish_github_packages.py --dry-run",
    "scripts:health": "python Soul-DevPortal-scripts/check_env_health.py",
    "scripts:clean": "python Soul-DevPortal-scripts/clean_workspace_caches.py --dry-run",
    "scripts:wal": "python Soul-DevPortal-scripts/audit_sqlite_wal.py",
    "scripts:catalog": "python Soul-DevPortal-scripts/sync_packages_catalog.py",
    "scripts:git": "python Soul-DevPortal-scripts/git_workspace_status.py",
    "scripts:env": "python Soul-DevPortal-scripts/gen_env_template.py",
    "scripts:ports": "python Soul-DevPortal-scripts/kill_port_conflicts.py",
    "pkg:relink": "npm run install:python",
    "install:python": "pip install -e Soul-DevPortal-Packages/logger && pip install -e Soul-DevPortal-Packages/runner && pip install -e Soul-DevPortal-Packages/config",
    "install:python:core": "pip install -e Soul-DevPortal-Packages/core -e Soul-DevPortal-Packages/ai-agents -e Soul-DevPortal-Packages/ai-router -e Soul-DevPortal-Packages/ai-local",
    "install:packages": "npm install && npm run install:python"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "@workspace/config": "*",
    "@workspace/logger": "*",
    "@workspace/runner": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "rollup": "^4.68.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  },
  "keywords": [
    "workspace",
    "devportal",
    "monorepo",
    "react19",
    "fastapi",
    "vite",
    "tailwind",
    "packages"
  ],
  "author": "Dheena",
  "license": "MIT",
  "build": {
    "appId": "com.soul.devportal",
    "productName": "Soul DevPortal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!data/**",
          "!**/*.db*"
        ]
      },
      {
        "from": "Soul-DevPortal-Packages",
        "to": "Soul-DevPortal-Packages",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/__pycache__/**",
          "!**/dist/**",
          "!**/*.egg-info/**"
        ]
      },
      {
        "from": "Soul-DevPortal-Docs",
        "to": "Soul-DevPortal-Docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/project-logos",
        "to": "public/project-logos",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "projects.json",
        "to": "projects.json"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
