{
  "name": "@workspace/packages-docs",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive developer portal, architecture specs, and live package explorer for the Soul Workspace monorepo.",
  "type": "module",
  "workspaces": [
    "Soul-DevPortal-Packages/*"
  ],
  "scripts": {
    "dev": "python scripts/run-dev.py --kill-port",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:client": "python scripts/run-client.py --kill-port",
    "dev:server": "python scripts/run-server.py --kill-port",
    "dev:all": "python Soul-DevPortal-Packages/runner/bin/run-all.py --kill-port",
    "dev:project": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --kill-port",
    "dev:portal:server": "python backend/main.py --port 8008 --reload",
    "extract": "python backend/main.py --extract-only",
    "dev:apexmind": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project apexmind-ai --kill-port",
    "dev:sonikoma": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project sonikoma --kill-port",
    "dev:outpass": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project outpass-system --kill-port",
    "dev:free-api": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project free-api-hub --kill-port",
    "dev:spatial": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project spatial-dimensions --kill-port",
    "dev:college": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project college-management-system --kill-port",
    "dev:globalpulse": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project globalpulse-ai --kill-port",
    "dev:postcraft": "python Soul-DevPortal-Packages/runner/bin/run-dev.py --project postcraft-ai --kill-port",
    "install:python": "pip install -e Soul-DevPortal-Packages/logger && pip install -e Soul-DevPortal-Packages/runner && pip install -e Soul-DevPortal-Packages/config",
    "install:packages": "npm install && npm run install:python"
  },
  "dependencies": {
    "@workspace/config": "*",
    "@workspace/logger": "*",
    "@workspace/runner": "*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "rollup": "^4.68.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^7.1.7"
  },
  "keywords": [
    "workspace",
    "devportal",
    "monorepo",
    "react19",
    "fastapi",
    "vite",
    "tailwind",
    "packages"
  ],
  "author": "Dheena",
  "license": "MIT"
}
