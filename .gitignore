# ==============================================================================
# Soul Workspace Monorepo - Comprehensive .gitignore
# Covering: Root DevPortal, Soul-DevPortal-Packages, Soul-DevPortal-Projects, Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
**/*.log

# ------------------------------------------------------------------------------
# Production Builds, Bundles & Artifacts
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
dist-electron/
release/
build/
**/build/
build-release/
**/build-release/
logs/
**/logs/
.next/
**/.next/
out/
**/.turbo/
.turbo/
.vite/
**/.vite/
*.backup.css
.vercel/
**/.vercel/

# ------------------------------------------------------------------------------
# Python Cache, Bytecode & Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
*.egg-info/
**/*.egg-info/
*.egg
.eggs/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST

# Virtual Environments
.venv/
**/.venv/
env/
**/env/
venv/
**/venv/
ENV/
env.bak/
venv.bak/

# Python Testing & Linters
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# TypeScript, Linters & Diagnostics
# ------------------------------------------------------------------------------
*.tsbuildinfo
**/*.tsbuildinfo
.eslintcache
**/.eslintcache
.cache/
**/.cache/
.parcel-cache/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/*.env
**/.env.*
!*.env.example
!**/*.env.example

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# ------------------------------------------------------------------------------
# Monorepo Sub-projects & Packages (Tracked/published independently)
# ------------------------------------------------------------------------------
Soul-DevPortal-Projects/
**/Soul-DevPortal-Projects/
Soul-DevPortal-Packages/
**/Soul-DevPortal-Packages/

# ------------------------------------------------------------------------------
# Standby Prototypes, Local Archives & Large Binaries
# ------------------------------------------------------------------------------
standby/
**/standby/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------------------------
# Backups & Temporary Files
# ------------------------------------------------------------------------------
*.backup
*.backup.*
*.backup*
**/*.backup*
*.bak
**/*.bak
*.tmp
**/*.tmp
*.temp
**/*.temp
*~
*.swp
*.swo

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Visual Studio Code & JetBrains IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Separate Repository
Soul-DevPortal-Packages/
